---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { resolveSiteIdentity } from "../utils/site-identity";
import { CONTACT, whatsappLink } from "../utils/site-config";

const page = await getEntry("pages", "contact");
const { Content } = page ? await render(page) : { Content: null };
const { siteTitle } = resolveSiteIdentity();

const seo = {
	title: `Hubungi Kami - ${siteTitle}`,
	description:
		"Hubungi Baitul Ilmi untuk pendaftaran dan informasi layanan les privat Islam di Banda Aceh. Dapatkan konsultasi gratis mengenai jadwal, materi, dan paket harga.",
	canonical: `${Astro.url.origin}/contact`,
};
---

<Base
	title={seo.title}
	description={seo.description}
	canonical={seo.canonical}
>
	<div class="about-page">
		<div class="about-content">
			<a href="/" class="back-link">
				<i class="fas fa-arrow-left"></i>
				Kembali ke Beranda
			</a>

			<div class="about-header">
				<h1>{page?.data.title || "Hubungi Kami"}</h1>
				<p class="tagline">Kami siap membantu perjalanan belajar Anda</p>
			</div>

			<section class="about-section">
				<h2>Informasi Kontak</h2>
				{Content ? (
					<div style="margin-bottom: 20px;">
						<Content />
					</div>
				) : (
					<p>Silakan hubungi kami untuk informasi lebih lanjut mengenai program, pendaftaran, atau konsultasi gratis.</p>
				)}
				<ul>
					<li>
						<strong>WhatsApp / Telepon:</strong>{" "}
						<a
							href={whatsappLink()}
							target="_blank"
							rel="noopener noreferrer"
							style="color:var(--primary-color); font-weight: 600;"
						>
							{CONTACT.phoneDisplay}
						</a>
					</li>
					<li><strong>Area Layanan:</strong> {CONTACT.serviceArea}</li>
					<li><strong>Jam Operasional:</strong> {CONTACT.openingHours}</li>
				</ul>
			</section>

			<section class="about-section">
				<h2>Lokasi</h2>
				<p>Kami melayani bimbingan belajar privat (ustadz datang ke rumah) untuk wilayah Kota Banda Aceh.</p>
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d127181.7118671618!2d95.25055459345711!3d5.5393521252192135!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3040377aaebba781%3A0x6b4fb6c9868bf0fc!2sBanda%20Aceh%2C%20Kota%20Banda%20Aceh%2C%20Aceh!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid"
					width="100%"
					height="400"
					style="border:0; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);"
					allowfullscreen=""
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</section>
		</div>
	</div>
</Base>
