---
import { getCollection } from "astro:content";
import teachers from "../data/teachers.json";
import materials from "../data/materials.json";
import packages from "../data/packages.json";
import faqs from "../data/faqs.json";

interface Props {
	placeholder?: string;
}

const { placeholder = "Cari..." } = Astro.props;

const [posts, pages] = await Promise.all([
	getCollection("posts"),
	getCollection("pages"),
]);

function cleanMarkdown(text = ""): string {
	return text
		.replace(/^---[\s\S]*?---/g, "")
		.replace(/#+\s+/g, "")
		.replace(/[-*+]\s+/g, "")
		.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
		.replace(/[*_~`]/g, "")
		.replace(/\s+/g, " ")
		.trim();
}

const searchIndex = [
	// Posts
	...posts.map((p) => ({
		title: p.data.title,
		url: `/posts/${p.id}`,
		collection: "Artikel",
		excerpt: p.data.excerpt || "",
		content: cleanMarkdown(p.body || ""),
	})),
	// Pages
	...pages.map((p) => {
		const cleanContent = cleanMarkdown(p.body || "");
		return {
			title: p.data.title,
			url: `/${p.id}`,
			collection: "Halaman",
			excerpt: cleanContent.slice(0, 160),
			content: cleanContent,
		};
	}),
	// Materials
	...materials.map((m) => ({
		title: m.title,
		url: "/#materials",
		collection: "Materi",
		excerpt: m.description,
		content: m.description,
	})),
	// Teachers
	...teachers.map((t) => ({
		title: t.name,
		url: "/#teachers",
		collection: "Pengajar",
		excerpt: `${t.education.replace(/\n/g, ", ")}`,
		content: `${t.name} ${t.education} ${t.teaching_experience}`,
	})),
	// Packages
	...packages.map((pkg) => ({
		title: `${pkg.name} (${pkg.price})`,
		url: "/#pricing",
		collection: "Paket",
		excerpt: `${pkg.per_session} • ${pkg.features.replace(/\n/g, ", ")}`,
		content: `${pkg.name} ${pkg.price} ${pkg.per_session} ${pkg.features}`,
	})),
	// FAQs
	...faqs.map((f) => ({
		title: f.question,
		url: "/#faq",
		collection: "FAQ",
		excerpt: f.answer,
		content: `${f.question} ${f.answer}`,
	})),
];
---

<div class="emdash-live-search" data-search-container>
	<div class="search-input-wrapper">
		<i class="fas fa-search search-icon" aria-hidden="true"></i>
		<input
			type="search"
			class="emdash-live-search-input"
			placeholder={placeholder}
			aria-label={placeholder}
			autocomplete="off"
			data-search-input
		/>
		<button
			type="button"
			class="search-clear-btn"
			aria-label="Hapus pencarian"
			data-search-clear
			style="display: none;"
		>
			<i class="fas fa-times-circle"></i>
		</button>
	</div>
	<div class="emdash-live-search-results" data-search-results style="display: none;">
		<div class="search-results-header" data-search-header></div>
		<div class="emdash-live-search-results-list" data-search-list></div>
		<div class="search-results-footer">
			<span><kbd>↑</kbd><kbd>↓</kbd> pilih</span>
			<span><kbd>↵</kbd> buka</span>
			<span><kbd>ESC</kbd> tutup</span>
		</div>
	</div>
</div>

<style>
	.emdash-live-search {
		position: relative;
		display: inline-block;
	}

	.search-input-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: 14px;
		color: var(--text-light);
		font-size: 0.85rem;
		pointer-events: none;
		transition: color 0.2s ease;
		z-index: 1;
	}

	.search-input-wrapper:focus-within .search-icon {
		color: var(--primary-color);
	}

	.emdash-live-search-input {
		width: 160px;
		height: 38px;
		padding: 0 32px 0 36px !important;
		font-size: 0.9rem !important;
		font-family: inherit;
		color: var(--text-dark);
		background-color: var(--bg-white);
		border: 1.5px solid rgba(0, 0, 0, 0.12) !important;
		border-radius: 50px !important;
		outline: none !important;
		transition: all 0.25s ease !important;
		box-sizing: border-box;
		-webkit-appearance: none;
	}

	.emdash-live-search-input::-webkit-search-decoration,
	.emdash-live-search-input::-webkit-search-cancel-button,
	.emdash-live-search-input::-webkit-search-results-button,
	.emdash-live-search-input::-webkit-search-results-decoration {
		display: none;
	}

	.emdash-live-search-input::placeholder {
		color: var(--text-light);
		opacity: 0.8;
	}

	.emdash-live-search-input:focus {
		width: 210px;
		border-color: var(--primary-color) !important;
		box-shadow: 0 0 0 3px rgba(46, 91, 94, 0.12) !important;
		background-color: #ffffff;
	}

	.search-clear-btn {
		position: absolute;
		right: 10px;
		background: none;
		border: none;
		color: var(--text-light);
		cursor: pointer;
		padding: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.85rem;
		z-index: 1;
	}

	.search-clear-btn:hover {
		color: var(--text-dark);
	}

	.emdash-live-search-results {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		width: 380px;
		max-height: 460px;
		background: var(--bg-white);
		border: 1px solid rgba(0, 0, 0, 0.08) !important;
		border-radius: var(--radius-md) !important;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04) !important;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		z-index: 1000;
	}

	.search-results-header {
		padding: 8px 14px;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--text-light);
		background: rgba(0, 0, 0, 0.02);
		border-bottom: 1px solid rgba(0, 0, 0, 0.05);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.emdash-live-search-results-list {
		max-height: 360px;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.search-results-footer {
		padding: 7px 14px;
		font-size: 0.7rem;
		color: var(--text-light);
		background: rgba(0, 0, 0, 0.02);
		border-top: 1px solid rgba(0, 0, 0, 0.05);
		display: flex;
		gap: 12px;
		align-items: center;
	}

	.search-results-footer kbd {
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.15);
		border-radius: 3px;
		padding: 1px 4px;
		font-family: inherit;
		font-size: 0.68rem;
		box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
		margin-right: 2px;
	}

	/* Result Item */
	:global(.emdash-live-search-result) {
		display: block;
		padding: 12px 16px !important;
		text-decoration: none;
		border-bottom: 1px solid rgba(0, 0, 0, 0.04);
		transition: all 0.15s ease;
		border-left: 3px solid transparent;
	}

	:global(.emdash-live-search-result:last-child) {
		border-bottom: none;
	}

	:global(.emdash-live-search-result:hover),
	:global(.emdash-live-search-result.is-active) {
		background-color: var(--bg-light);
		border-left-color: var(--primary-color);
		padding-left: 17px !important;
	}

	:global(.emdash-live-search-result-meta) {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 4px;
	}

	:global(.emdash-live-search-result-collection) {
		display: inline-block;
		font-size: 0.68rem !important;
		font-weight: 700 !important;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 2px 7px;
		border-radius: 4px;
	}

	:global(.badge-artikel) {
		background-color: rgba(46, 91, 94, 0.1);
		color: var(--primary-color);
	}

	:global(.badge-halaman) {
		background-color: rgba(107, 114, 128, 0.1);
		color: #4b5563;
	}

	:global(.badge-materi) {
		background-color: rgba(226, 109, 92, 0.12);
		color: #c24a3a;
	}

	:global(.badge-pengajar) {
		background-color: rgba(212, 163, 115, 0.18);
		color: #8c5b29;
	}

	:global(.badge-paket) {
		background-color: rgba(234, 179, 8, 0.15);
		color: #92400e;
	}

	:global(.badge-faq) {
		background-color: rgba(139, 92, 246, 0.12);
		color: #6d28d9;
	}

	:global(.emdash-live-search-result-title) {
		font-size: 0.93rem !important;
		font-weight: 600 !important;
		color: var(--text-dark) !important;
		line-height: 1.35;
		margin-bottom: 4px;
	}

	:global(.emdash-live-search-result:hover .emdash-live-search-result-title),
	:global(.emdash-live-search-result.is-active .emdash-live-search-result-title) {
		color: var(--primary-color) !important;
	}

	:global(.emdash-live-search-result-snippet) {
		font-size: 0.8rem !important;
		color: var(--text-light) !important;
		line-height: 1.45;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Keyword Highlight */
	:global(mark.search-highlight) {
		background-color: rgba(212, 163, 115, 0.32) !important;
		color: var(--primary-color) !important;
		font-weight: 700 !important;
		padding: 0 2px !important;
		border-radius: 2px !important;
	}

	@media (max-width: 992px) {
		.emdash-live-search {
			width: 100%;
			display: block;
		}

		.search-input-wrapper {
			width: 100%;
		}

		.emdash-live-search-input {
			width: 100% !important;
			background: var(--bg-light);
			font-size: 0.95rem !important;
			height: 42px;
			padding-left: 38px !important;
		}

		.emdash-live-search-results {
			width: 100%;
			left: 0;
			right: 0;
			max-height: 320px;
		}
	}
</style>

<script is:inline define:vars={{ searchIndex }}>
	document.addEventListener("DOMContentLoaded", () => {
		const containers = document.querySelectorAll("[data-search-container]");

		containers.forEach((container) => {
			const input = container.querySelector("[data-search-input]");
			const results = container.querySelector("[data-search-results]");
			const list = container.querySelector("[data-search-list]");
			const header = container.querySelector("[data-search-header]");
			const clearBtn = container.querySelector("[data-search-clear]");

			if (!input || !results || !list) return;

			let activeIndex = -1;

			const closeResults = () => {
				results.style.display = "none";
				list.innerHTML = "";
				if (header) header.textContent = "";
				activeIndex = -1;
			};

			const updateClearBtn = () => {
				if (clearBtn) {
					clearBtn.style.display = input.value.trim() ? "flex" : "none";
				}
			};

			if (clearBtn) {
				clearBtn.addEventListener("click", () => {
					input.value = "";
					updateClearBtn();
					closeResults();
					input.focus();
				});
			}

			function escapeHtml(str) {
				return String(str || "").replace(/[&<>"']/g, function (m) {
					switch (m) {
						case "&": return "&amp;";
						case "<": return "&lt;";
						case ">": return "&gt;";
						case '"': return "&quot;";
						case "'": return "&#039;";
						default: return m;
					}
				});
			}

			function highlightMatches(text, query) {
				if (!text) return "";
				if (!query) return escapeHtml(text);

				const words = query
					.trim()
					.split(/\s+/)
					.filter((w) => w.length > 0)
					.map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));

				if (words.length === 0) return escapeHtml(text);

				const regex = new RegExp("(" + words.join("|") + ")", "gi");
				const parts = text.split(regex);

				return parts
					.map((part) => {
						if (regex.test(part)) {
							return `<mark class="search-highlight">${escapeHtml(part)}</mark>`;
						}
						return escapeHtml(part);
					})
					.join("");
			}

			function buildContextualSnippet(item, query, maxLen = 135) {
				const full = (item.content || item.excerpt || "").replace(/\s+/g, " ").trim();
				if (!full) return "";

				const q = query.trim().toLowerCase();
				const lower = full.toLowerCase();
				const idx = lower.indexOf(q);

				if (idx === -1) {
					// Fallback to beginning of excerpt or content
					const fallback = (item.excerpt || full).trim();
					let s = fallback.slice(0, maxLen);
					if (fallback.length > maxLen) s += "...";
					return highlightMatches(s, query);
				}

				// Center around match
				let start = Math.max(0, idx - 35);
				if (start > 0) {
					const space = full.indexOf(" ", start);
					if (space !== -1 && space < idx) start = space + 1;
				}

				let end = Math.min(full.length, start + maxLen);
				if (end < full.length) {
					const space = full.lastIndexOf(" ", end);
					if (space > idx + q.length) end = space;
				}

				let snippet = full.slice(start, end).trim();
				if (start > 0) snippet = "..." + snippet;
				if (end < full.length) snippet = snippet + "...";

				return highlightMatches(snippet, query);
			}

			function getCollectionBadgeClass(collection) {
				switch (collection) {
					case "Artikel": return "badge-artikel";
					case "Halaman": return "badge-halaman";
					case "Materi": return "badge-materi";
					case "Pengajar": return "badge-pengajar";
					case "Paket": return "badge-paket";
					case "FAQ": return "badge-faq";
					default: return "badge-halaman";
				}
			}

			const performSearch = (query) => {
				updateClearBtn();
				const q = query.trim().toLowerCase();
				if (!q) {
					closeResults();
					return;
				}

				const terms = q.split(/\s+/).filter(Boolean);

				const scoredMatches = searchIndex
					.map((item) => {
						const titleLower = item.title.toLowerCase();
						const excerptLower = (item.excerpt || "").toLowerCase();
						const contentLower = (item.content || "").toLowerCase();

						let score = 0;

						// Title exact match
						if (titleLower.includes(q)) score += 100;
						// Excerpt exact match
						if (excerptLower.includes(q)) score += 40;
						// Content exact match
						if (contentLower.includes(q)) score += 20;

						// Term-by-term scoring
						for (const term of terms) {
							if (titleLower.includes(term)) score += 25;
							if (excerptLower.includes(term)) score += 10;
							if (contentLower.includes(term)) score += 5;
						}

						return { item, score };
					})
					.filter(({ score }) => score > 0)
					.sort((a, b) => b.score - a.score);

				if (scoredMatches.length === 0) {
					if (header) header.textContent = "Pencarian";
					list.innerHTML = `
						<div style="padding: 24px 16px; text-align: center; color: var(--text-light);">
							<i class="fas fa-search" style="font-size: 1.6rem; color: #CBD5E1; margin-bottom: 8px; display: block;"></i>
							<div style="font-weight: 600; color: var(--text-dark); margin-bottom: 4px;">Tidak ada hasil ditemukan</div>
							<div style="font-size: 0.8rem;">Coba cari dengan kata kunci lain seperti <em>Al-Qur'an</em>, <em>Bahasa Arab</em>, <em>Pengajar</em>, atau <em>Harga</em>.</div>
						</div>
					`;
					results.style.display = "flex";
					return;
				}

				if (header) {
					header.innerHTML = `Ditemukan <strong>${scoredMatches.length}</strong> hasil pencarian`;
				}

				list.innerHTML = scoredMatches
					.slice(0, 6)
					.map(({ item }, index) => {
						const badgeClass = getCollectionBadgeClass(item.collection);
						const highlightedTitle = highlightMatches(item.title, query);
						const highlightedSnippet = buildContextualSnippet(item, query);

						return `
							<a href="${item.url}" class="emdash-live-search-result" data-index="${index}">
								<div class="emdash-live-search-result-meta">
									<span class="emdash-live-search-result-collection ${badgeClass}">${escapeHtml(item.collection)}</span>
								</div>
								<div class="emdash-live-search-result-title">${highlightedTitle}</div>
								${
									highlightedSnippet
										? `<p class="emdash-live-search-result-snippet">${highlightedSnippet}</p>`
										: ""
								}
							</a>
						`;
					})
					.join("");

				results.style.display = "flex";
			};

			input.addEventListener("input", (e) => {
				performSearch(e.target.value);
			});

			input.addEventListener("keydown", (e) => {
				const items = list.querySelectorAll(".emdash-live-search-result");
				if (!items.length || results.style.display === "none") return;

				if (e.key === "ArrowDown") {
					e.preventDefault();
					activeIndex = (activeIndex + 1) % items.length;
					updateActiveItem(items);
				} else if (e.key === "ArrowUp") {
					e.preventDefault();
					activeIndex = (activeIndex - 1 + items.length) % items.length;
					updateActiveItem(items);
				} else if (e.key === "Enter" && activeIndex >= 0 && items[activeIndex]) {
					e.preventDefault();
					items[activeIndex].click();
				} else if (e.key === "Escape") {
					closeResults();
				}
			});

			function updateActiveItem(items) {
				items.forEach((item, idx) => {
					if (idx === activeIndex) {
						item.classList.add("is-active");
						item.scrollIntoView({ block: "nearest" });
					} else {
						item.classList.remove("is-active");
					}
				});
			}

			// Close on outside click
			document.addEventListener("click", (e) => {
				if (!container.contains(e.target)) {
					closeResults();
				}
			});
		});
	});
</script>
